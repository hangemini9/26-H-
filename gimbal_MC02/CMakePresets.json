{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Vehicle",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GIMBAL_MANUAL_CALRUN": "OFF",
                "GIMBAL_DELAY_TEST": "OFF",
                "GIMBAL_OZONE_WATCH": "ON"
            }
        },
        {
            "name": "DelayTest",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GIMBAL_MANUAL_CALRUN": "OFF",
                "GIMBAL_DELAY_TEST": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Vehicle",
            "configurePreset": "Vehicle"
        },
        {
            "name": "DelayTest",
            "configurePreset": "DelayTest"
        }
    ]
}
